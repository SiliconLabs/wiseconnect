    condition: [brd4180a]
    file_list:
      - path: si91x_ncp_uart_config.h
  - path: "brd4180b"
    condition: [brd4180b]
    file_list:
      - path: si91x_ncp_uart_config.h
  - path: "brd4186c"
    condition: [brd4186c]
    file_list:
      - path: si91x_ncp_uart_config.h
  - path: "brd4271a"
    condition: [brd4271a]
    file_list:
      - path: si91x_ncp_uart_config.h
  - path: "brd4270a"
    condition: [brd4270a]
    file_list:
      - path: si91x_ncp_uart_config.h
  - path: "brd4120a"
    condition: [brd4120a]

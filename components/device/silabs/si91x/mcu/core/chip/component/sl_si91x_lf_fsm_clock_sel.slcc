id: sl_si91x_lf_fsm_clock_selection
label: LF-FSM Clock Selection
package: platform_siwx91x
metadata:
  sbom:
    license: MSLA
description: >
  This component enables 32 kHz clock configuration within the LF-FSM domain. Not required when an external oscillator is used.
category: Device|Si91x|MCU|Core
quality: production
component_root_path: "components/device/silabs/si91x/mcu/core/chip"
config_file:
  - path: config/sl_si91x_lf_fsm_clock_sel.h
define:
  - name: LF_FSM_CLOCK_UC
    value: '1'
conflicts:
  - name: si91x_32kHz_external_oscillator
provides:
  - name: sl_si91x_lf_fsm_clock_selection
id: si91x_32kHz_external_oscillator
label: 32kHz External Oscillator
package: platform_siwx91x
metadata:
  sbom:
    license: MSLA
description: >
  This component enables selection of the UULP GPIO pin for connecting an external 32 kHz oscillator.
category: Device|Si91x|MCU|Core
quality: production
component_root_path: "components/device/silabs/si91x/mcu/core/chip"
config_file:
  - path: config/sl_si91x_external_oscillator.h
define:
  - name: SI91X_32kHz_EXTERNAL_OSCILLATOR
    value: '1'
conflicts:
  - name: sl_si91x_lf_fsm_clock_selection
provides:
  - name: si91x_32kHz_external_oscillator
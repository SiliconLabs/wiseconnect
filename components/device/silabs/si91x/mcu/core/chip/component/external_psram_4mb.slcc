id: external_psram_4mb
label: 4MB PSRAM (External)
package: platform_siwx91x
description: >
  Select this component when the SiWx91x board uses 4 MB of external PSRAM.
category: Device|Si91x|MCU|PSRAM
quality: production
provides:
  - name: external_psram_4mb
  - name: external_psram_implementation
template_contribution:
    - name: psram_present
      value: 1
    - name: external_psram_present
      value: 1
    - name: device_psram_addr
      value: 167772160 # 0x0A00_0000
    - name: device_psram_size
      value: 4194304

metadata:

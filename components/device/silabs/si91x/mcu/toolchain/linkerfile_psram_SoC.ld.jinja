		_sidata = __etext + (__sleep_code_end__ - __sleep_code_start__);
		_last_ram_location = _sidata;

	  	{%- elif flash_present %}
	  	} > ram AT> rom
			{%- else %}
	  	} > ram

	  	/* _sidata is used in code startup code */
		_sidata = __etext + (__sleep_code_end__ - __sleep_code_start__);
	    {% endif %}
	{%- else %}
	/* _sidata is used in code startup code */
	_sidata = __etext;
	{% endif %}

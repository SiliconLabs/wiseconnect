{%- if flash_present %}
	/* Copy/zero tables after exidx; LONG() forward-reference __etext, .data, .bss */
	.copy.table :
	{
		. = ALIGN(4);
		__copy_table_start__ = .;
		LONG (__etext)
		LONG (__data_start__)
		LONG ((__data_end__ - __data_start__) / 4)
		__copy_table_end__ = .;
	} > rom :tables

	.zero.table :
	{
		. = ALIGN(4);
		__zero_table_start__ = .;
		LONG (__bss_start__)
		LONG ((__bss_end__ - __bss_start__) / 4)
		__zero_table_end__ = .;
	} > rom :tables
{%- else %}
	/* No flash: no copy/zero tables. Define start==end symbols outside any output
	   section so LLD doesn't complain about empty allocatable sections. Startup
	   code's "if (end > start)" check skips the iteration. */
	__copy_table_start__ = .;
	__copy_table_end__ = .;
	__zero_table_start__ = .;
	__zero_table_end__ = .;

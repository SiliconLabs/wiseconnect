{%- if si91x_platform_core and not si91x_log_formatted_output_enable %}
	/* Non-allocatable .log_fmt: placed at the very end of SECTIONS so it does
	   not disrupt LLD's location counter / PHDR tracking for the allocatable
	   sections above (notably .copy.table / .zero.table which only carry
	   linker-generated LONG() content). Excluded from .bin via (INFO). */
	.log_fmt (INFO) :
	{
		__log_start__ = .;

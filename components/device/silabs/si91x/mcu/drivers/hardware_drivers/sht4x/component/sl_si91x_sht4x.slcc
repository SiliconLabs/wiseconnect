id: sl_si91x_sht4x
label: SHT4x Humidity and Temperature Sensor
package: platform_siwx91x
description: >
  This component provides a driver implementation to control the SHT4x humidity and temperature sensor.
category: Device|Si91x|MCU|Compatibility
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: "components/device/silabs/si91x/mcu/drivers/hardware_drivers/sht4x"
source:
  - path: "src/sl_si91x_sht4x.c"
include:
  - path: "inc"
    file_list:
      - path: "sl_i2cspm.h"
      - path: "sl_si91x_sht4x_instances.h"
provides:
  - name: sl_si91x_sht4x
  - name: sl_sht4x
  - name: i2cspm
requires:
  - name: sl_i2c
  - name: sleeptimer
  - name: sht4x_driver
  - name: log_none

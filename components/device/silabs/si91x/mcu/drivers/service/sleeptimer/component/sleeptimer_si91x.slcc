id: sleeptimer_si91x
label: Sleep Timer
package: platform_siwx91x
description: >
  This component provides software timers and delays using a low-frequency 
  real-time clock peripheral. It uses one hardware timer to create multiple software timer instances.
  Installing this component also installs the Sleep Timer driver dependency.
category: Device|Si91x|MCU|Service
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: "components/device/silabs/si91x/mcu/drivers/service/sleeptimer"
source:
  - path: src/sl_sleeptimer_hal_si91x_sysrtc.c
include:
  - path: inc
    file_list:
      - path: sli_sleeptimer_hal.h
define:
  - name: __STATIC_INLINE
    value: "static inline"
  - name: __WEAK
    value: "__attribute__((weak))"
  - name: SI91X_SYSRTC_PRESENT
    value: 1
  - name: SI91X_PLATFORM
    value: 1
  - name: SL_SLEEP_TIMER
  - name: SL_CODE_COMPONENT_SLEEPTIMER_SI91X
    value: sleeptimer_si91x
requires:
  - name: sleeptimer
  - name: rsilib_sysrtc
  - name: log_none
conflicts:
  - name: sl_sysrtc
template_contribution:
  - name: code_classification_components
    value: sleeptimer_si91x
provides:
  - name: sleeptimer_si91x

id: si91x_log_backend_uart
label: SL Log Backend UART
package: platform_siwx91x
description: >
  This component provides the UART backend interface for the SiWx91x logger.
category: Device|Si91x|MCU|Service|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
provides:
  - name: si91x_log_backend_uart
  - name: log_backend
requires:
  - name: sl_ulp_uart
  - name: log
  - name: log_platform_core
recommends:
  - id: si91x_log  
root_path: components/device/silabs/si91x/mcu/drivers/service/sl_log
source:
  - path: src/sl_log_platform_backend.c
config_file:
  - path: config/sl_log_proprietary_config.h
  - path: config/sl_log_common_config.h  
template_contribution:
  - name: si91x_platform_backend
    value: 1    
  - name: component_catalog
    value: log_backend_proprietary     
define:
  - name: SL_LOG_SI91X_BACKEND
    value: "1"

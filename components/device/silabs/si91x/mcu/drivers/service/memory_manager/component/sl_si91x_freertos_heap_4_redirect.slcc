id: sl_si91x_freertos_heap_4_redirect
label: SiWx91x Memory Manager Redirect
package: platform_siwx91x
description: >
  Redirects malloc/free and aligned APIs to FreeRTOS heap_4 via --wrap for a
  single unified heap. GCC only (requires GCC toolchain). When installed, sets
  80 KB heap and enables configUSE_MALLOC_FAILED_HOOK for heap-exhaustion tracking.
category: Device|Si91x|MCU|Service
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: components/device/silabs/si91x/mcu/drivers/service/memory_manager
source:
  - path: src/sl_si91x_freertos_heap_4_wrap.c
define:
  - name: SL_SI91X_FREERTOS_HEAP_4_REDIRECT
    value: '1'
requires:
  - name: freertos
  - name: freertos_heap_4
  - name: wiseconnect_toolchain_plugin
provides:
  - name: sl_si91x_freertos_heap_4_redirect
  - name: memory_manager_redirect
toolchain_settings:
  - option: gcc_linker_option
    value: -Wl,--wrap=malloc -Wl,--wrap=free -Wl,--wrap=calloc -Wl,--wrap=realloc
  - option: gcc_linker_option
    value: -Wl,--wrap=aligned_alloc -Wl,--wrap=memalign -Wl,--wrap=posix_memalign
  - option: gcc_linker_option
    value: -Wl,-u,__wrap_aligned_alloc -Wl,-u,__wrap_memalign -Wl,-u,__wrap_posix_memalign
  - option: gcc_linker_option
    value: -Wl,--wrap=_free_r -Wl,--wrap=_malloc_r -Wl,--wrap=_calloc_r -Wl,--wrap=_realloc_r

id: systemlevel_pll
label: PLL
package: platform_siwx91x
description: >
  Phase Locked Loop API's
category: Device|Si91x|MCU|Internal|System-Level Drivers
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
component_root_path: "components/device/silabs/si91x/mcu/drivers/systemlevel"
source:
  - path: "src/rsi_pll.c"
include:
  - path: "inc"
    file_list:
    - path: "rsi_pll.h"
provides:
  - name: systemlevel_pll
requires:
  - name: systemlevel_reg_spi
  - name: romdriver_clks
  - name: code_classification
    condition: [psram_core]
define:
  - name: PLL_ROMDRIVER_PRESENT
  - name: SL_CODE_COMPONENT_SYSTEMLEVEL_PLL
    value: systemlevel_pll
template_contribution:
  - name: code_classification_components
    value: systemlevel_pll
    condition: [psram_core]

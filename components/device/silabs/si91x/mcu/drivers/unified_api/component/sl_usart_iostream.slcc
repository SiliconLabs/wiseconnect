id: sl_usart_iostream
label: 'IO Stream: USART'
package: platform_siwx91x
description: >
  This component enables UART communication using lower-level programming,
  interacting directly with hardware registers or dedicated UART libraries.
  It operates in asynchronous mode for sending and receiving data. It performs communication over the
  virtual COM port (VCOM) in a bare-metal environment using the I/O stream service, echoing back
  any characters received over the serial connection.
category: Device|Si91x|MCU|Peripheral
quality: production
metadata:
  sbom:
    license: Zlib
root_path: "components/device/silabs/si91x/mcu/drivers/unified_api"
define:
   - name: IOSTREAM_USART
     value: 1 
provides:
  - name: sl_usart_iostream
requires:
  - name: udma_linker_config
  - name: sl_usart
  - name: log_none

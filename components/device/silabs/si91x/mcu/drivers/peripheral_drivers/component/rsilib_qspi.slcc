id: rsilib_qspi
label: QSPI
package: platform_siwx91x
description: >
  Quad Serial Peripheral Interface Peripheral API's
category: Device|Si91x|MCU|Internal|RSI Peripheral Drivers
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
component_root_path: "components/device/silabs/si91x/mcu/drivers/peripheral_drivers"
source:
  - path: "src/rsi_qspi.c"
include:
  - path: "inc"
    file_list:
    - path: "rsi_qspi.h"
    - path: "rsi_qspi_proto.h"
provides:
  - name: rsilib_qspi
requires:
  - name: romdriver_timer
  - name: code_classification
    condition: [psram_core]
define: 
  - name: QSPI_ROMDRIVER_PRESENT
  - name: SL_CODE_COMPONENT_RSILIB_QSPI
    value: rsilib_qspi
template_contribution:
  - name: code_classification_components
    value: rsilib_qspi
    condition: [psram_core]
  - name: psram_ram_data_files
    value: rsi_qspi

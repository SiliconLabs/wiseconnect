{# Generate event-mapped wrapper function - V9: derive callback name from event name #}
{%- if event_mapped_wrapper is iterable -%}
  {%- if event_mapped_wrapper is mapping -%}
    {# event_mapped_wrapper is a single dict #}
void {{ event_mapped_wrapper["name"] }}()
{
  {%- for callback in event_mapped_wrapper["callbacks"] %}
  {{ event_mapped_wrapper["registration_api"] }}({{ callback["event_id"] }},
                                            (void *)rsi_ble_{{ callback["callback"] }}_driver_callback);
  {%- endfor %}
}

  {%- else -%}
    {# event_mapped_wrapper is a list #}
    {%- for mapped_impl in event_mapped_wrapper -%}
void {{ mapped_impl["name"] }}()
{
  {%- for callback in mapped_impl["callbacks"] %}
  {{ mapped_impl["registration_api"] }}({{ callback["event_id"] }},
                                            (void *)rsi_ble_{{ callback["callback"] }}_driver_callback);
  {%- endfor %}
}

    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{# Generate GAP/SMP wrapper function implementations - V10: derive callback names from event names #}
{%- if wrapper_implementations is iterable -%}
  {%- if wrapper_implementations is mapping -%}
    {# wrapper_implementations is a dict - iterate over keys #}
    {%- for wrapper_key in wrapper_implementations.keySet() %}{% set wrapper_impl = wrapper_implementations[wrapper_key] %}
void {{ wrapper_impl["name"] }}()
{
  {# GAP/SMP style - transform callback names or keep NULL #}
  {{ wrapper_impl["registration_api"] }}(
  {%- for callback in wrapper_impl["callbacks"] -%}
{%- if callback -%}
rsi_ble_{{ callback }}_driver_callback
{%- else -%}
NULL
{%- endif -%}
{%- if not loop.last %},
                                 {% else %});
{% endif -%}
  {%- endfor -%}
}

    {%- endfor -%}
  {%- else -%}
    {# wrapper_implementations is a list - each item is a wrapper dict #}
    {%- for wrapper_impl in wrapper_implementations -%}
void {{ wrapper_impl["name"] }}()
{
  {# GAP/SMP style - transform callback names or keep NULL #}
  {{ wrapper_impl["registration_api"] }}(
  {%- for callback in wrapper_impl["callbacks"] -%}
{%- if callback -%}
rsi_ble_{{ callback }}_driver_callback
{%- else -%}
NULL
{%- endif -%}
{%- if not loop.last %},
                                 {% else %});
{% endif -%}
  {%- endfor -%}
}

    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

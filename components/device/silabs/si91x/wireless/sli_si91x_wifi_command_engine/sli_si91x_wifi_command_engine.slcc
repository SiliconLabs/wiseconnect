id: sli_si91x_wifi_command_engine
label: Sli SiWx91x WiFi Command Engine
package: wifi
description: >
    Core Command Engine thread configuration for SiWx91x Wi-Fi: schedules TX requests, processes RX
    responses, and signals synchronous response completion to issuer threads (thread-based or
    event-flag notification).
category: Command Engine
component_root_path: ./components/device/silabs/si91x/wireless/sli_si91x_wifi_command_engine
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
define:
    - name: SL_CODE_COMPONENT_SLI_SI91X_WIFI_CMD_ENGINE
      value: sli_si91x_wifi_cmd_engine
template_contribution:
    - name: code_classification_components
      value: sli_si91x_wifi_cmd_engine
provides:
    - name: sli_si91x_wifi_command_engine
source:
- path: src/sli_si91x_wifi_command_engine_config.c
- path: src/sli_si91x_wifi_command_engine.c
include:
- path: inc
  file_list:
    - path: sli_si91x_wifi_command_engine.h
    - path: sli_wifi_command_engine_config.h
    - path: sli_si91x_wifi_command_engine_packet.h
requires:
    - name: sli_command_engine
    - name: sli_routing_utility
    - name: sli_event_engine
    - name: sli_buffer_manager
    - name: sli_si91x_wifi_event_handler
    - name: log_none

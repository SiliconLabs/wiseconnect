id: sli_hal_si91x
package: wifi
description: > 
  The SL Wi-Fi HAL (Hardware Abstraction Layer) provides an interface for the
  SL Wi-Fi driver to interact with the underlying hardware. It abstracts the
  hardware details and provides a consistent API for the driver to use.
label: SiWx91x Wireless Subsystem HAL
category: Device|Si91x|Wireless
quality: production
metadata:
  sbom:
    license: Zlib
component_root_path: ./components/device/silabs/si91x/wireless/sli_hal_si91x
ui_hints:
  visibility: never
provides:
    - name: sli_hal_si91x
source:
- path: src/sli_hal_si91x.c
include:
- path: inc
  file_list:
    - path: sli_hal_si91x_constants.h
    - path: sli_hal_si91x_packet.h
    - path: sli_hal_si91x.h

define:
- name: SL_WIFI_COMPONENT_INCLUDED
- name: SL_CODE_COMPONENT_SLI_HAL_SI91X
  value: sli_hal_si91x
template_contribution:
- name: code_classification_components
  value: sli_hal_si91x

requires:
- name: sli_routing_utility
- name: log_none
- condition: ["device_si91x"]
  name: sl_si91x_mcu
- condition: ["device_si91x"]
  name: rsilib_headers
- condition: ["device_si91x"]
  name: romdriver_headers
- condition: ["device_si91x"]
  name: cmsis_driver_headers
- condition: ["device_si91x"]
  name: romdriver_romtable_headers
- condition: ["device_efx"]
  name: efx32_si91x_wireless_connector
- condition: ["device_efx"]
  name: gpiointerrupt
- condition: ["device_efx"]
  name: emlib
- condition: ["device_efx"]
  name: dmadrv
- condition: ["device_efx"]
  name: sl_si91x_ncp_bus
id: sli_si91x_wifi_event_handler
label:  Sli SiWx91x WiFi handler
package: wifi
description: >
    SiWx91x-specific TX and RX event handler: processes host-side TX/RX events from the event
    engine, enqueues response payloads to the command engine, and signals synchronous response
    completion to issuer threads (thread-based or event-flag notification).
category: SiWx91x WiFi handler
component_root_path: ./components/device/silabs/si91x/wireless/sli_si91x_wifi_event_handler
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
include:
- path: inc
  file_list:
    - path: sli_si91x_wifi_event_handler.h
source:
- path: src/sli_si91x_wifi_event_handler.c
provides:
    - name: sli_si91x_wifi_event_handler
    - name: wifi_event_handler
requires:
- name: sli_routing_utility
- name: sli_event_engine
- name: sli_command_engine
- name: log_none

project_name: sl_si91x_file_system_common_flash
package: platform_nwp_siwx91x_app
description: 'This example project configures QSPI read and write from flash.

  '
category: example|Service
quality: production
label: SiWx91x Platform - File System Common Flash
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: sl_si91x_freertos_heap_4_redirect
  condition:
  - toolchain_gcc
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_si91x_internal_stack
- id: sl_si91x_littlefs_common_flash
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SLI_SI91X_MCU_CONFIG_RADIO_BOARD_BASE_VER
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/file_system_output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

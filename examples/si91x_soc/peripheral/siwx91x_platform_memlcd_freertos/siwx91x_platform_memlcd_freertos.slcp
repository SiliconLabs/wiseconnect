project_name: siwx91x_platform_memlcd_freertos
package: platform_siwx91x_app
description: 'MEMLCD sample running under FreeRTOS on the SiWx91x SoC.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - MEMLCD FreeRTOS
component:
- id: freertos_heap_4
- id: sl_main
- id: status
- id: sl_assert
- id: sleeptimer
- id: dmd_memlcd
- id: glib
- id: memlcd_917
- id: sl_ssi
- id: sl_ulp_timer
- id: syscalls
- id: si91x_memory_default_config
- instance:
  - timer0
  id: ulp_timers_instance
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
source:
- path: app.c
- path: memlcd_app.c
- path: memlcd_freertos.c
include:
- path: .
  file_list:
  - path: app.h
  - path: memlcd_app.h
  - path: memlcd_freertos.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/MEMLCD_OP_SCRN.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

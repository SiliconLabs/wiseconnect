project_name: sl_si91x_usart_sync_master
package: platform_siwx91x_app
description: 'This application demonstrates the usage of the USART master mode for transmitting and receiving data in synchronous full-duplex mode.  It highlights how the USART module enables simultaneous, bidirectional data flow using a synchronized clock signal, ensuring efficient communication between devices.  This mode is ideal for applications where both transmitting and receiving of data need to occur at the same time with high data integrity.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - USART Synchronous Master
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_usart
source:
- path: app.c
- path: usart_sync_example.c
include:
- path: .
  file_list:
  - path: app.h
  - path: usart_sync_example.h
define:
- name: SLI_SI91X_MCU_CONFIG_RADIO_BOARD_BASE_VER
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/image513d.png
- path: resources/uc_screen/usart_uc.png
- path: resources/readme/usart_master_console_output.png
configuration:
- name: SL_USART_MODE
  value: SL_USART_MODE_SYNCHRONOUS_MASTER
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

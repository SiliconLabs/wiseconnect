project_name: platform_siwx91x_uart_freertos
package: platform_siwx91x_app
description: 'This application demonstrates the usage of UART transmit and receive in full duplex mode within a FreeRTOS environment on the SiWx91x SoC device.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - UART FreeRTOS
component:
- id: freertos_heap_4
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_uart
source:
- path: app.c
- path: uart_freertos.c
include:
- path: .
  file_list:
  - path: app.h
  - path: uart_freertos.h
define:
- name: SLI_SI91X_MCU_CONFIG_RADIO_BOARD_BASE_VER
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/uc_screen/uart_uc.png
- path: resources/readme/output_console_uart.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

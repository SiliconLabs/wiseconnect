project_name: sl_si91x_qei
package: platform_siwx91x_app
description: 'This application demonstrates how to use the QEI on the SI91x SoC device.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - QEI
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_qei
- instance:
  - timer0
  id: ulp_timers_instance
source:
- path: app.c
- path: qei_example.c
include:
- path: .
  file_list:
  - path: app.h
  - path: qei_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/uc_screen/qei_uc_screen.png
- path: resources/readme/output_qei.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

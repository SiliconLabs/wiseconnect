project_name: sl_si91x_adc_fifo_mode
package: platform_siwx91x_app
description: 'This application demonstrates the configuration and use of the ADC peripheral in FIFO mode  on the SiWx917 SoC, showcasing efficient data handling through the ADC''s FIFO buffer mechanism.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - ADC FIFO Mode
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_adc
- id: adc_instance
  instance:
  - channel_1
source:
- path: adc_fifo_mode_example.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: adc_fifo_mode_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: GAIN_OFFSET_CAL_EN
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output.png
- path: resources/uc_screen/sl_adc_channel_uc_screen.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

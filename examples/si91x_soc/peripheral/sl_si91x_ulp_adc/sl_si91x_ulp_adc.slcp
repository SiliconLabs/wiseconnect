project_name: sl_si91x_ulp_adc
package: platform_siwx91x_app
description: 'This application demonstrates the how to configure and use the ULP ADC peripheral on the the SiWx917 SoC device.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - ULP ADC
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_compact
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_adc
- id: adc_instance
  instance:
  - channel_1
- id: sllib_wireless_shutdown
- id: sl_power_manager
- id: pm_ps2_component
- id: debug_ulp_component
- id: adc_ulp_component
- id: dma_ulp_component
source:
- path: sl_ulp_adc_example.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: sl_ulp_adc_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: GAIN_OFFSET_CAL_EN
- name: SLI_SI91X_MCU_ENABLE_RAM_BASED_EXECUTION
- name: SL_SI91X_ULP_STATE_ENABLE
template_contribution:
- name: ulp_platform
  priority: 0
  value: 1
- name: user_files_ps2
  value: sl_ulp_adc_example.*
- name: user_files_ps2
  value: app.*
- name: user_files_ps2
  value: main.*
- name: user_files_ps2
  value: sl_system_process_action.*
  condition:
  - sl_system
- name: user_files_ps2
  value: sl_event_handler.*
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output.png
- path: resources/uc_screen/sl_adc_channel_uc_screen.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

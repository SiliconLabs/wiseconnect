project_name: siwx91x_platform_pcm_primary_freertos
package: platform_siwx91x_app
description: 'PCM primary example running under FreeRTOS on the SiWx91x SoC.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - PCM Primary FreeRTOS
component:
- id: freertos_heap_4
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: sl_pcm
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: pcm_instance
  instance:
  - pcm0
source:
- path: app.c
- path: pcm_primary_freertos.c
include:
- path: .
  file_list:
  - path: app.h
  - path: pcm_primary_freertos.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: SYSCALLS_WRITE
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/PCM_Primary_Secondary_Pins.png
- path: resources/uc_screen/pcm_primary_uc_screen.png
- path: resources/readme/output.png
requires:
- name: sl_gpio
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

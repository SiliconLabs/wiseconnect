project_name: sl_si91x_calendar
package: platform_siwx91x_app
description: 'This application demonstrates how to configure and use the Calendar peripheral on the SiLabs MCU.  It includes setting up the calendar module, configuring date and time values,  and using the peripheral to manage time-based events or scheduling functionalities effectively.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - CALENDAR
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_calendar
- id: sl_ulp_timer
source:
- path: calendar_example.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: calendar_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

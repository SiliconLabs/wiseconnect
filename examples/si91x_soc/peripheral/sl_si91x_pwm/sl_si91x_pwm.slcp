project_name: sl_si91x_pwm
package: platform_siwx91x_app
description: 'This application demonstrates how to configure PWM peripheral.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - PWM
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: pwm_instance
  instance:
  - channel_0
- id: sl_pwm
source:
- path: app.c
- path: pwm_example.c
include:
- path: .
  file_list:
  - path: app.h
  - path: pwm_example.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/uc_screen/pwm_uc_screen.png
- path: resources/readme/output1.png
- path: resources/readme/output2.png
- path: resources/readme/Center_Edge_Aligned.png
- path: resources/readme/Lead_Edge_Aligned.png
- path: resources/readme/Tail_Edge_Aligned.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

project_name: siwx91x_platform_ulp_uart_freertos
package: platform_siwx91x_app
description: 'ULP UART example running under FreeRTOS on the SiWx91x SoC.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - ULP UART FreeRTOS
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: status
- id: syscalls
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: network_manager
- id: basic_network_config_manager
- id: wifi_resources
- id: si91x_mem_config_3
- id: sl_gpio
- id: gpio_ulp_component
- id: sl_ulp_uart
- id: usart_ulp_component
- id: sl_power_manager
- id: pm_ps2_component
- id: debug_ulp_component
- id: dma_ulp_component
- id: si91x_log
source:
- path: ulp_uart_freertos.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ulp_uart_freertos.h
define:
- name: SYSCALLS_WRITE
- name: SLI_SI91X_MCU_ENABLE_RAM_BASED_EXECUTION
- name: SL_SI91X_ULP_STATE_ENABLE
- name: SL_SI91X_ENABLE_LOWPWR_RET_LDO
  value: '1'
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
template_contribution:
- name: ulp_platform
  priority: 0
  value: 1
- name: user_files_ps2
  value: ulp_uart_freertos.*
- name: user_files_ps2
  value: app.*
- name: user_files_ps2
  value: main.*
- name: user_files_ps2
  value: sl_system_process_action.*
  condition:
  - sl_system
- name: user_files_ps2
  value: sl_event_handler.*
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/ulp_uart_gpio_toggle.png
- path: resources/readme/ulpuart_uc.png
- path: resources/readme/ulp_uart_continuous_toggling.png
requires:
- name: device_needs_ram_execution
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

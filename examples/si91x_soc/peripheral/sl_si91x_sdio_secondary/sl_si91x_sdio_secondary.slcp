project_name: sl_si91x_sdio_secondary
package: platform_siwx91x_app
description: 'This application demonstrates how to use the SDIO Secondary interface on the Si91x SoC devices.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - Peripheral SDIO Secondary
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_sdio_secondary
source:
- path: sdio_secondary_example.c
- path: app.c
include:
- path: .
  file_list:
  - path: sdio_secondary_example.h
  - path: app.h
define:
- name: __SYSTICK
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/output_sdio.png
- path: resources/uc_screen/sdio_secondary.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

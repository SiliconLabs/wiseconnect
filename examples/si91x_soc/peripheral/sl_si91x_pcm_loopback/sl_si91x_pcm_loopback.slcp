project_name: sl_si91x_pcm_loopback
package: platform_siwx91x_app
description: 'Demonstrates how to use the PCM loopback interface on the SI91x SoC device.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - PCM Loopback
component:
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: sl_pcm
- id: pcm_instance
  instance:
  - pcm0
source:
- path: app.c
- path: pcm_loopback.c
include:
- path: .
  file_list:
  - path: app.h
  - path: pcm_loopback.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
define:
- name: SYSCALLS_WRITE
- name: I2S_LOOP_BACK
other_file:
- path: resources/readme/setupdiagram.png
- path: resources/readme/image505d.png
- path: resources/uc_screen/i2s_primary_uc_screen.png
- path: resources/readme/loopback_output.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

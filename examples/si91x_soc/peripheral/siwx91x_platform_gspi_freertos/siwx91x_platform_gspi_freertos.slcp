project_name: platform_siwx91x_gspi_freertos
package: platform_siwx91x_app
description: 'This application demonstrates how to configure and use the GSPI interface in a FreeRTOS task  on the Si91x SoC device.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - GSPI FreeRTOS
component:
- id: freertos_heap_4
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: sl_gspi
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
- id: ulp_timers_instance
  instance:
  - timer0
source:
- path: app.c
- path: gspi_freertos.c
include:
- path: .
  file_list:
  - path: app.h
  - path: gspi_freertos.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/image505d.png
- path: resources/readme/setupdiagram.png
- path: resources/uc_screen/gspi_uc_screen.png
- path: resources/readme/output_gspi.png
configuration:
- name: SL_ULP_TIMER_TIMER0_DIRECTION
  value: UP_COUNTER
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0

project_name: sl_si91x_rgb_led
package: platform_siwx91x_app
description: 'This application demonstrates how to use RGB LED

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - RGB LED
component:
- id: sl_main
- id: syscalls
- id: si91x_memory_default_config
- id: sl_si91x_rgb_led
- id: sl_si91x_led_917
  instance:
  - led0
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
source:
- path: app.c
- path: rgb_led.c
include:
- path: .
  file_list:
  - path: app.h
  - path: rgb_led.h
define:
- name: SYSCALLS_WRITE
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/readme/setupdiagram.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

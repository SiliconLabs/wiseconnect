project_name: siwx91x_platform_sysrtc_freertos
package: platform_siwx91x_app
description: 'Sysrtc example running under FreeRTOS on the SiWx91x SoC.

  '
category: example|peripheral
quality: production
label: SiWx91x Platform - SYSRTC FreeRTOS
component:
- id: freertos_heap_4
- id: sl_main
- id: status
- id: syscalls
- id: si91x_memory_default_config
- id: sl_sysrtc
- id: sl_si91x_led_917
  instance:
  - led0
  condition:
  - device_is_module
- id: sl_si91x_led_917
  instance:
  - led1
  condition:
  - device_has_chip
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
source:
- path: sysrtc_freertos.c
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: sysrtc_freertos.h
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
other_file:
- path: resources/uc_screen/sysrtc_uc_screen.png
- path: resources/readme/setupdiagram.png
- path: resources/readme/image509d.png
- path: resources/readme/output.png
- path: resources/readme/output_prs_out.png
- path: resources/readme/output_prs_in.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
readme:
- path: readme.md
filter:
- name: Device Type
  value:
  - SoC
- name: MCU
  value:
  - 32-bit MCU
- name: Level
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Wi-Fi
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

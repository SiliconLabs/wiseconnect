project_name: ble_gatt_long_read_psram
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - PSRAM Gatt Long Read FreeRTOS
category: Example|BLE
description: 'Demonstrates GATT long read on SiWx91x with PSRAM in SoC FreeRTOS. Demonstrated by reading long characteristic data via prepared ATT procedures.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_MCU_ENABLE_PSRAM_FEATURE
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: psram_core
- id: text_segment_in_psram
- id: data_segment_in_psram
- id: sl_power_manager
- id: wireless_wakeup_ulp_component
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/blegattlr_soc_ncp.png
- path: resources/readme/blegattlrdeviceadvertising.png
- path: resources/readme/blegattlrdeviceconnected.png
- path: resources/readme/blegattlrdatasent.png
- path: resources/readme/blegattlrsocserverprints.png
- path: resources/readme/blegattlrncpserverprints.png
- path: resources/readme/blegattleconfigurator.png
- path: resources/readme/blegattlradvertiser.png
- path: resources/readme/blegattleclient.png
- path: resources/readme/blegattlrsocclientprints.png
- path: resources/readme/blegattlrncpclientprints.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0

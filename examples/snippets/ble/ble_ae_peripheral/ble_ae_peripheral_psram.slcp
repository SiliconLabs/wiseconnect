project_name: ble_ae_peripheral_psram
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - PSRAM AE Peripheral FreeRTOS
category: Example|BLE
description: 'Demonstrates how to use BLE Extended Advertising in peripheral role with dual adv sets and periodic advertising on SiWx91x with PSRAM in SoC FreeRTOS. This is demonstrated by two adv sets.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_MCU_ENABLE_PSRAM_FEATURE
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: psram_core
- id: text_segment_in_psram
- id: data_segment_in_psram
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/ble_ae_peripheral_soc_ncp.png
- path: resources/readme/output1.png
- path: resources/readme/output2.png
- path: resources/readme/connect.png
- path: resources/readme/scan.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

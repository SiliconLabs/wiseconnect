project_name: ble_unified_coex_app_ncp
package: bluetooth_le_siwx91x_app
quality: production
label: BLE Unified Coex Application (NCP)
category: Example|BLE
description: 'Demonstrates BLE Unified Component Framework with modular protocol architecture on Si91x NCP. Supports GAP, GATT Server/Client, SMP, and Extended/Legacy Advertising.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Project Difficulty
  value:
  - Advanced
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: sl_si91x_spi_bus
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: ble_unified
- id: gap
- id: si91x_ble_adv_scan_default_config
- id: smp
- id: gatt_server
- id: gatt_client
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: gcc_linker_option
  value: -u _printf_float
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
- name: configUSE_POSIX_ERRNO
  value: '1'
readme:
- path: README.md
ui_hints:
  highlight:
  - path: README.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

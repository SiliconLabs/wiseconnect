project_name: ble_testmodes_ncp
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - NCP Testmodes FreeRTOS
category: Example|BLE
description: 'Demonstrates BLE GAP peripheral test procedures on SiWx91x over SPI NCP with FreeRTOS. Demonstrated by controlled GAP test behavior for validation with peers.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - NCP
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: sl_si91x_spi_bus
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: gcc_linker_option
  value: -u _printf_float
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/blerxtestmode1.png
- path: resources/readme/blerxtestmodebtmonlog.png
- path: resources/readme/bletestmodeserialteriminalsocprints.png
- path: resources/readme/bletxtestmode1.png
- path: resources/readme/bletxtestmodebtmon1.png
- path: resources/readme/setup_diagram.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

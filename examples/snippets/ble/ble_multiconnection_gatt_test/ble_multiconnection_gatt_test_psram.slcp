project_name: ble_multiconnection_gatt_test_psram
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - PSRAM Multiconnection GATT Test FreeRTOS
category: Example|BLE
description: 'Demonstrates multiple simultaneous BLE links on SiWx91x with PSRAM in SoC FreeRTOS using central and peripheral roles with GATT. Demonstrated by secure connections and multi-peer access.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - SoC
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: ble_device_info.c
- path: ble_main_task.c
- path: ble_subtasks.c
- path: app.c
include:
- path: .
  file_list:
  - path: ble_device_info.h
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_MCU_ENABLE_PSRAM_FEATURE
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: psram_core
- id: text_segment_in_psram
- id: data_segment_in_psram
- id: sl_power_manager
- id: wireless_wakeup_ulp_component
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/blemultigatt_soc_ncp.png
- path: resources/readme/output_1.png
- path: resources/readme/output_2.png
- path: resources/readme/output_3.png
- path: resources/readme/output_4.png
- path: resources/readme/central_connected.png
- path: resources/readme/central_scan.png
- path: resources/readme/output_5.png
- path: resources/readme/peripheral_connected.png
- path: resources/readme/peripheral.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1

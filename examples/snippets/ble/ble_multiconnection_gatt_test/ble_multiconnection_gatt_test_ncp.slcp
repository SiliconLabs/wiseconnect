project_name: ble_multiconnection_gatt_test_ncp
package: bluetooth_le_siwx91x_app
quality: production
label: BLE - NCP Multiconnection GATT Test FreeRTOS
category: Example|BLE
description: 'Demonstrates multiple simultaneous BLE links on SiWx91x over SPI NCP with FreeRTOS using central and peripheral roles with GATT. Demonstrated by secure connections and multi-peer access.

  '
filter:
- name: Wireless Technology
  value:
  - BLE
- name: Device Type
  value:
  - NCP
- name: Project Difficulty
  value:
  - Advanced
- name: Quality
  value:
  - Production
source:
- path: ble_device_info.c
- path: ble_main_task.c
- path: ble_subtasks.c
- path: app.c
include:
- path: .
  file_list:
  - path: ble_device_info.h
  - path: app.h
  - path: ble_config.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: sl_si91x_spi_bus
- id: network_manager
- id: basic_network_config_manager
- id: ble
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: gcc_linker_option
  value: -u _printf_float
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
readme:
- path: readme.md
other_file:
- path: resources/readme/blemultigatt_soc_ncp.png
- path: resources/readme/output_1.png
- path: resources/readme/output_2.png
- path: resources/readme/output_3.png
- path: resources/readme/output_4.png
- path: resources/readme/central_connected.png
- path: resources/readme/central_scan.png
- path: resources/readme/output_5.png
- path: resources/readme/peripheral_connected.png
- path: resources/readme/peripheral.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0

project_name: wifi_concurrent_mode_dual_ip_ncp
package: wifi_app
quality: production
label: Wi-Fi - Concurrent Mode Dual IP (NCP)
category: Example|Wi-Fi
description: 'Demonstrates concurrent Wi-Fi Client and Wi-Fi Access Point with data transfer in IPv6 UDP on STA and IPv4 TCP RX on AP.

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Project Difficulty
  value:
  - Beginner
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_ENABLE_IPV6
component:
- id: sl_main
- id: slist
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: sl_si91x_spi_bus
- id: network_manager
- id: basic_network_config_manager
- id: bsd_socket
- id: sl_si91x_asynchronous_socket
- id: sl_si91x_wireless
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/concurrent_dual_ip_ncp.png
- path: resources/readme/application_console_output_ncp.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

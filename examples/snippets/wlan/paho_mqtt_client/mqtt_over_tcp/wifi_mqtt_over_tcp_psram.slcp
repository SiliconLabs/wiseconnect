project_name: wifi_mqtt_over_tcp_psram
package: wifi_app
quality: production
label: Wi-Fi - Paho MQTT OVER TCP (PSRAM)
category: Example|Wi-Fi
description: 'Demonstrates how SiWx91x device is configured as an MQTT client over TCP, connects to an MQTT broker, subscribes to a topic, and publishes messages on a particular MQTT topic using the Paho MQTT library

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Project Difficulty
  value:
  - Beginner
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SLI_SI91X_MCU_ENABLE_PSRAM_FEATURE
- name: SL_SI91X_PRINT_DBG_LOG
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: text_segment_in_psram
- id: data_segment_in_psram
- id: udma_linker_config
- id: psram_core
- id: wifi
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: paho_mqtt_embedded
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/mqtt_add_topic_name.png
- path: resources/readme/mqtt_server.png
- path: resources/readme/mqtt_application_prints_soc.png
- path: resources/readme/mqtt_application_prints_ncp.png
- path: resources/readme/mqtt_connect.png
- path: resources/readme/mqtt_connect_subscribe.png
- path: resources/readme/mqtt_delete_connections.png
- path: resources/readme/mqtt_explorer_msg.png
- path: resources/readme/mqtt_publish_msg_from_explorer.png
- path: resources/readme/setup_soc_ncp.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

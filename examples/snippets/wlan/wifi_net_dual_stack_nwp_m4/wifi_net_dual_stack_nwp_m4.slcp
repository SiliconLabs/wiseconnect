project_name: wifi_net_dual_stack_nwp_m4
package: wifi_app
quality: production
label: Wi-Fi - Network Dual Stack NWP M4 (SoC)
category: Example|Wi-Fi
description: 'Demonstrates IPv4/IPv6 on NWP Wi-Fi offload and on M4 lwIP, with TCP/UDP traffic on both stacks.

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Project Difficulty
  value:
  - Advanced
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_ENABLE_IPV6
- name: LWIP_IPV6
  value: '1'
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: si91x_memory_default_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_network_dual_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: sl_si91x_asynchronous_socket
- id: log_none
- id: si91x_log
- id: si91x_log_iostream_formatted
- id: iostream_si91x
- id: iostream_uart_si91x
  instance:
  - vcom
requires:
- name: device_needs_ram_execution
  condition:
  - si91x_common_flash
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
readme:
- path: readme.md
other_file:
- path: resources/readme/dual_stack_tcp_rx.png
- path: resources/readme/dual_stack_tcp_tx.png
- path: resources/readme/dual_stack_udp_rx.png
- path: resources/readme/dual_stack_udp_tx.png
- path: resources/readme/test_setup.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
  profile: wiseconnect_soc
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2

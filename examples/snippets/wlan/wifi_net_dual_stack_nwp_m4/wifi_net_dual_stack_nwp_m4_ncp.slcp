project_name: wifi_net_dual_stack_nwp_m4_ncp
package: wifi_app
quality: production
label: Wi-Fi - Network Dual Stack NWP M4 (NCP)
category: Example|Wi-Fi
description: 'Demonstrates IPv4/IPv6 on NWP Wi-Fi offload and on M4 lwIP, with TCP/UDP traffic on both stacks.

  '
filter:
- name: Wireless Technology
  value:
  - Wi-Fi
- name: Project Difficulty
  value:
  - Advanced
source:
- path: app.c
include:
- path: .
  file_list:
  - path: app.h
define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_ENABLE_IPV6
- name: LWIP_IPV6
  value: '1'
component:
- id: sl_main
- id: freertos
- id: freertos_heap_4
- id: device_init
- id: spidrv
  instance:
  - exp
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: iostream_stdlib_config
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_network_dual_stack
- id: sl_si91x_spi_bus
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: sl_si91x_asynchronous_socket
- id: log_none
- id: log_backend_iostream
- id: log_backend_iostream_formatted
- id: log_platform_specific
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: gcc_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
- option: llvm_compiler_option
  value: -Wall -Werror -Wno-error=deprecated-declarations
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: configUSE_POSIX_ERRNO
  value: '1'
- name: configTOTAL_HEAP_SIZE
  value: '51200'
- name: configTIMER_TASK_PRIORITY
  value: '55'
- name: SL_LOG_CONFIG_LEVEL_COMPILE_TIME
  value: SL_LOG_CONFIG_LEVEL_INFO
readme:
- path: readme.md
other_file:
- path: resources/readme/dual_stack_tcp_rx.png
- path: resources/readme/dual_stack_tcp_tx.png
- path: resources/readme/dual_stack_udp_rx.png
- path: resources/readme/dual_stack_udp_tx.png
- path: resources/readme/test_setup.png
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0
